# ---------------------------------------------------------------------------
# Soul Circuit
#
# Repo tracks Game/ (the Unity project) and Audio/ (the FMOD Studio project).
# Art/ and Planning/ are excluded deliberately: together they are ~1.3 GB and
# contain two .psd files over GitHub's hard 100 MB per-file limit
# (Planning/Visuals/Title Screen Ideas.psd 247 MB, Art/Title Screens/heisse.psd 141 MB).
# Revisit if a paid Git LFS data pack is added.
# ---------------------------------------------------------------------------

Art/
Planning/

# ---------------------------------------------------------------------------
# Unity
# ---------------------------------------------------------------------------

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Visual Studio / Rider / VS Code cache and generated project files
.vs/
.vscode/
.idea/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Vendored Asset Store packages ship .unitypackage files inside Assets/ (for
# example the URP material variants under Abiogenesis3d). Those are source, not
# build output, so they must survive the *.unitypackage rule above.
!/Game/Tesseract/Assets/**/*.unitypackage

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# FMOD Studio
# ---------------------------------------------------------------------------

# FMOD Studio working state, not source
.unsaved/
.user/
*.cache

# FMOD generated cache inside the Unity project
/Game/Tesseract/Assets/Plugins/FMOD/Cache/

# FMOD editor log written into the Unity project root
fmod_editor.log

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini
